# 内容来源只需要这一项。文章、CSS、图片及 CDN 地址均从 Feed/HTML/CSS 引用自动解析。
# 留空：立即正常退出，不下载、生成、发布或刷新 CDN。非空但来源不可用：保留已有发布，首次生成空候选。
NEWS_FEED_URL=

# 以下用于手动开发运行；正式安装器自动写入服务器 JSON 配置并启用发布/CDN，参见 README。
# 以下为部署选项，不是来源配置；通常保留默认值即可。
# 测试可覆盖为独立临时目录，生成数据不得放进源码仓库或主站 build。
NEWS_SITE_ORIGIN=https://jit.pro
NEWS_PUBLIC_PATH=/zh/news/
NEWS_WORK_DIR=/data/jitai-news-data
NEWS_PYTHON=python3
# 默认只生成候选；部署流程确认后才启用自动发布。
NEWS_ENABLE_PUBLISH=0
NEWS_MAX_RESOURCE_BYTES=20971520
NEWS_MAX_TOTAL_BYTES=268435456
NEWS_MAX_ITEMS=2000
# 正常 Feed 将全部内容下线仍需显式允许；抓取失败不能被当作下线。
NEWS_ALLOW_EMPTY_FEED=0

# 仅 publish 使用，初次部署时设置：站点入口与全站发布共享锁。
# NEWS_LIVE_LINK 需不存在，或指向本工作目录 releases 下版本的符号链接。
NEWS_LIVE_LINK=/data/jitai-docs-site/zh/news
NEWS_RELEASE_LOCK=/data/locks/jitai-site-release.lock

# 公开内容抓取不需要 key。仅启用 CDN API 时配置环境凭证，不写入仓库。
NEWS_CDN_MODE=none
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=
